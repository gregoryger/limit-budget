{
  "name": "limit-student-budget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"node --use-system-ca --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --use-system-ca dist-server/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src server shared tests docs README.md package.json *.config.ts tsconfig*.json"
  },
  "dependencies": {
    "@remotion/player": "4.0.506",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.506",
    "undici": "^6.29.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
